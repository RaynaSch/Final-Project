import pandas as pd
import plotly.express as px
import requests as r
from dash import Dash, dcc, html, Output, Input

URL = "https://myplate.food/api/v1/recipes"

resp = r.get(URL, timeout=10)
resp.raise_for_status()          # fails loudly if the request didn't work
response = resp.json()

# Build the DataFrame once, at startup
recipes_df = pd.DataFrame([
    {
        "name": rec["name"],
        "category": rec["category"],
        "calories": rec["calories"],
        "rating": rec["rating"]["value"],
    }
    for rec in response["results"]
])
print(recipes_df.head())         # sanity check: is there data?

app = Dash(__name__)

app.layout = html.Div([
    html.H1("Recipe by Category"),
    html.Div([
        html.Div([
            html.H2("Controls"),
            html.Br(),
            html.H3("Recipe Select"),
            dcc.Dropdown(
                id="recipe_dd",
                options=[
                    {"label": "PRO", "value": "Protein"},
                    {"label": "VEG", "value": "Vegetables"},
                    {"label": "DAR", "value": "Dairy"},
                    {"label": "GRA", "value": "Grains"},
                    {"label": "FRU", "value": "Fruits"},
                ],
                placeholder="All categories",
                clearable=True,
                style={"width": "200px", "margin": "0 auto"},
            ),
        ], style={"width": "350px", "height": "350px", "display": "inline-block",
                  "vertical-align": "top", "border": "1px solid black", "padding": "20px"}),

        html.Div([
            dcc.Graph(id="major_cat"),
            html.H2("Major Category",
                    style={"border": "2px solid black", "width": "200px", "margin": "0 auto"}),
        ], style={"width": "700px", "display": "inline-block"}),
    ]),
], style={"text-align": "center", "display": "inline-block", "width": "100%"})


@app.callback(
    Output("major_cat", "figure"),
    Input("recipe_dd", "value"),
)
def update_plot(selected_category):
    df = recipes_df.copy()
    title = "Average Calories by Category: All Recipes"

    if selected_category:
        df = df[df["category"] == selected_category]
        title = f"Average Calories: {selected_category}"

    summary = (df.groupby("category")["calories"]
                 .mean()
                 .reset_index(name="Avg Calories"))

    return px.bar(summary, x="Avg Calories", y="category",
                  color="category", title=title)


if __name__ == "__main__":
    app.run(debug=True)   # debug=True shows callback errors in the browser


