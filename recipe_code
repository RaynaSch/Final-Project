# Create layouts for the dashboard
def box_style(**extra):
    """Shared 'box model' styling: border, padding, margin"""
    style = {"border": "1px solid #ccc", "borderRadius": "8px",
             "padding": "12px", "margin": "10px"}
    style.update(extra)
    return style


def make_control(label, component):
    """A labelled control that sits side by side with the others"""
    return html.Div([html.Label(label), component],
                    style={"width": "220px", "display": "inline-block",
                           "margin": "8px", "verticalAlign": "top",
                           "textAlign": "left"})
# Adesuwa add docstring

def make_dropdown(label, dd_id, options, placeholder):
    return make_control(label, dcc.Dropdown(id=dd_id, options=options,
                                            placeholder=placeholder, clearable=True))
# Adesuwa add docstring

def recipe_card(rank, r):
    """One top-5 entry: rank, thumbnail (html.Img), linked name, calories"""
    pieces = [html.B(f"{rank}.  ")]
    if isinstance(r.image_url, str) and r.image_url:
        pieces.append(html.Img(src=r.image_url,
                               style={"width": "80px", "height": "80px",
                                      "objectFit": "cover", "borderRadius": "6px",
                                      "verticalAlign": "top"}))
    pieces.append(html.Div([
        html.A(r.name, href=r.url, target="_blank", rel="noopener"),
        html.Br(),
        html.Span(f"{r.calories} cal per serving"),
        html.Br(),
        html.I(f"{r.rating:.2f} ★ from {r.ratings:,} ratings"),
    ], style={"display": "inline-block", "verticalAlign": "top",
              "marginLeft": "12px"}))
    return html.Div(pieces, style={"textAlign": "left", "margin": "10px 0"})
