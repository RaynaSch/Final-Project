# MyPlate category and food group breakdowns
CATEGORIES = ["Main dish", "Side dish", "Salad", "Soup", "Sauce",
              "Dessert", "Breakfast", "Bread", "Snack", "Beverage"]
FOOD_GROUPS = [("Vegetables", "vegetables"), ("Fruits", "fruits"),
               ("Grains", "grains"), ("Protein foods", "protein-foods"),
               ("Dairy", "dairy")]

# Load all recipes
def to_df(results):
    rows = []
    for r in results:
        rating = r.get("rating") or {}
        groups = r.get("food_groups", [])
        rows.append({
            "name": r["name"],
            "url": r["recipe_url"],
            "image_url": r.get("image_url"),
            "category": r.get("category", ""),
            "group_list": groups,
            "food_groups": ", ".join(groups),
            "calories": r.get("calories"),          
            "rating": rating.get("value"),
            "ratings": rating.get("count", 0),      
        })
    return pd.DataFrame(rows)
# Adesuwa add doc string

def load_all_recipes():
    results, offset = [], 0
    while True:
        for _ in range(3):
            resp = requests.get(API, params={"limit": API_MAX_LIMIT, "offset": offset},
                                timeout=20)
            if resp.status_code == 429:
                time.sleep(float(resp.headers.get("Retry-After", 5)) + 1)
                continue
            resp.raise_for_status()
            break
        else:
            raise RuntimeError("Rate limited by myplate.food; wait a minute and restart.")
        data = resp.json()
        page = data.get("results", [])
        results.extend(page)
        offset += len(page)
        if not page or offset >= data.get("total", 0):
            break
        time.sleep(0.4)
    return to_df(results).drop_duplicates(subset="url").reset_index(drop=True)
# Adesuwa add docstring

LOAD_ERROR = None
try:
    ALL_DF = load_all_recipes()
    print(f"Loaded {len(ALL_DF):,} recipes")
except Exception as exc:                     
    LOAD_ERROR = f"Could not load recipes: {exc}"
    ALL_DF = to_df([])
    print(LOAD_ERROR)

# Create a filter to affect everything
def filter_df(category, group, cal, min_rating):
    df = ALL_DF
    if category:
        df = df[df["category"] == category]
    if group:
        df = df[df["group_list"].apply(lambda g: group in g)]
    if cal == "low":                      # 75 or fewer
        df = df[df["calories"] <= 75]
    elif cal == "medium":                 # 76 to 150
        df = df[(df["calories"] > 75) & (df["calories"] <= 150)]
    elif cal == "high":                   # over 150
        df = df[df["calories"] > 150]
    if min_rating:                        # slider at 0 = any rating
        df = df[df["rating"] >= min_rating]
    return df


def empty_fig(title):
    fig = px.bar(title=title)
    fig.update_layout(xaxis={"visible": False}, yaxis={"visible": False})
    return fig
