# App callback
@app.callback(
    Output(component_id="recipe_table", component_property="data"),
    Output(component_id="recipe_table", component_property="page_current"),
    Output(component_id="match_count", component_property="children"),
    Output(component_id="avg_rating", component_property="children"),
    Output(component_id="summary_note", component_property="children"),
    Output(component_id="top5", component_property="children"),
    Output(component_id="cat_count_chart", component_property="figure"),
    Output(component_id="cat_cal_chart", component_property="figure"),
    Input(component_id="category", component_property="value"),
    Input(component_id="group", component_property="value"),
    Input(component_id="cal", component_property="value"),
    Input(component_id="min_rating", component_property="value"),
)
def update_dashboard(category, group, cal, min_rating):
    if LOAD_ERROR:
        blank = empty_fig("No data")
        return [], 0, LOAD_ERROR, "–", "", [], blank, blank

    df = filter_df(category, group, cal, min_rating)
    if df.empty:
        blank = empty_fig("No recipes match these filters")
        return [], 0, "0 recipes match", "–", "No recipes match these filters.", [], blank, blank

    # Table rows with links
    rows = []
    for rec in df.sort_values("name").to_dict("records"):
        safe = rec["name"].replace("[", "(").replace("]", ")")
        rows.append({
            "recipe": f"[{safe}]({rec['url']})",
            "category": rec["category"],
            "calories": rec["calories"],
            "rating": rec["rating"],
            "ratings": rec["ratings"],
            "food_groups": rec["food_groups"],
        })

    # Average rating and top 5, over everything that matches
    avg = f"{df['rating'].mean():.2f} ★"
    top = df.sort_values(["ratings", "rating"], ascending=False).head(5)
    cards = [recipe_card(rank, r) for rank, r in enumerate(top.itertuples(), start=1)]

    # Charts
    by_cat = df.groupby("category").agg(Recipes=("name", "count"),
                                        AvgCal=("calories", "mean")).reset_index()
    fig_count = px.bar(by_cat, x="Recipes", y="category", color="category",
                       text="Recipes", title="Recipes by category")
    fig_count.update_layout(showlegend=False,
                            yaxis={"categoryorder": "total ascending", "title": ""})
    fig_cal = px.bar(by_cat.round({"AvgCal": 0}), x="AvgCal", y="category",
                     color="category", text="AvgCal",
                     title="Average calories per serving by category",
                     labels={"AvgCal": "Avg calories"})
    fig_cal.update_layout(showlegend=False,
                          yaxis={"categoryorder": "total ascending", "title": ""})

    return (rows, 0, f"{len(df):,} recipes match", avg,
            "Average of the ratings of every matching recipe", cards,
            fig_count, fig_cal)
